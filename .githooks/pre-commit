#!/usr/bin/env bash
#
# pre-commit — block secrets from entering this repository.
#
# Installed by install.sh, which points core.hooksPath at .githooks/ so a fresh
# clone gets it without touching .git/hooks.
#
# What it does:
#   1. Refuses to commit a staged file that is not in the .gitignore allowlist.
#      Only `git add -f` can stage one, so this catches force-added files
#      without naming any sensitive path in this public repository.
#   2. Runs betterleaks over the staged content only.
#
# Bypass for a confirmed false positive:
#   SKIP=betterleaks git commit ...
#
# This repository is PUBLIC. A secret committed here is public immediately, and
# removing it later does not undo that: a pushed commit that is rewritten out of
# history stays retrievable from GitHub by its SHA. Rewriting is not a fix.
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"

# --- 1. Files outside the allowlist -------------------------------------------
# `--no-index` evaluates the ignore rules even for paths already in the index,
# which is exactly the state a force-added file is in.
outside_allowlist="$(
  git diff --cached --name-only --diff-filter=ACMR -z 2>/dev/null \
    | git check-ignore --no-index -z --stdin 2>/dev/null \
    | tr '\0' '\n' || true
)"

if [[ -n "$outside_allowlist" ]]; then
  {
    printf 'pre-commit blocked: staged files are not in the .gitignore allowlist.\n\n'
    printf '%s\n' "$outside_allowlist" | sed 's/^/  /'
    printf '\nThey can only be staged with `git add -f`. Review each one for secrets\n'
    printf 'and machine state. To publish it, add its exact path to .gitignore;\n'
    printf 'otherwise remove it from the index:\n'
    printf '  git restore --staged <path>\n'
  } >&2
  exit 1
fi

# --- 2. Secret scan over the staged content -----------------------------------
# SKIP only bypasses the scanner; the allowlist check above always runs.
if [[ "${SKIP:-}" == "betterleaks" || "${SKIP:-}" == "*" ]]; then
  printf 'pre-commit: secret scan skipped (SKIP=%s)\n' "$SKIP" >&2
  exit 0
fi

if ! command -v betterleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pre-commit: betterleaks is not installed, so the staged changes were NOT scanned.

Install it to enable the check:
  brew install betterleaks
EOF
  # Fail open on purpose: a missing optional tool must not block commits.
  exit 0
fi

if betterleaks git --pre-commit --staged --redact --no-banner; then
  exit 0
fi

cat >&2 <<'EOF'

pre-commit blocked: betterleaks reported a possible secret in the staged changes.

Read the finding above and remove the credential, then commit again.

Remember this repository is public. Committing it publishes it, and a later
history rewrite does not take it back: GitHub keeps serving an unreachable
object by its SHA, so rotate the credential instead of relying on removal.

Genuine false positive? Add an allowlist entry to .betterleaks.toml using
`condition = "AND"` so it cannot over-suppress. Do not disable the hook.
EOF

exit 1
