# =============================================================================
# Dotfiles repository ignore rules — FILE ALLOWLIST
#
# Deny by default: every file is ignored unless it is listed below. To publish
# a new file, review it for secrets and machine state, then add its exact path.
# Whole trees are allowed only for hand-written code.
#
# NOTE: in .gitignore a `#` is only a comment at the start of a line; text after
# a pattern on the same line becomes part of the pattern and silently disables it.
# =============================================================================

# Ignore every file, but keep descending into directories so the exact paths
# below can be re-included.
*
!*/

# Repository plumbing
!/.gitignore
!/README.md
!/install.sh
!/.betterleaks.toml
!/.githooks/pre-commit
!/.github/workflows/secrets.yml
!/scripts/herdr-move-workspace

# Shell and prompt
!/zsh/.zshenv
!/zsh/.zprofile
!/zsh/.zshrc
!/starship.toml

# Neovim
!/nvim/init.lua
!/nvim/nvim-pack-lock.json
!/nvim/lua/**
!/nvim/after/**
!/nvim/colors/**
!/nvim/spell/**
/nvim/spell/*.spl

# Terminal and window management
!/ghostty/config
!/ghostty/shaders/cursor_smear_gentleman.glsl
!/ghostty/themes/gentleman
!/aerospace/aerospace.toml
!/aerospace/scripts/rotate-workspaces.sh
!/sketchybar/sketchybarrc
!/sketchybar/colors.sh
!/sketchybar/icons.sh
!/sketchybar/theme.sh
!/sketchybar/items/**
!/sketchybar/plugins/**
!/herdr/config.toml

# CLI tools
!/git/config
!/git/ignore
!/gh/config.yml
!/lazygit/config.yml
!/yazi/keymap.toml
!/yazi/theme.toml
!/yazi/yazi.toml
!/fastfetch/config.jsonc
!/fastfetch/ascii.txt
!/gwq/config.toml

# Never publish OS metadata, even inside an allowed tree.
.DS_Store

# `!*/` re-includes every directory, and git lists a nested repository as a
# single entry that `git add -A` would commit as a submodule. Exclude the
# directories that hold nested repositories; this must stay after `!*/`.
/herdr/plugins/
