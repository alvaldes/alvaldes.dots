{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "padding": {
      "top": 0,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 15,
      // "key": "󱗞 ",
      "format": "{at-symbol-colored}{user-name-colored}",
      "keyColor": "green",
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "yellow",
    },
    // {
    //   "type": "kernel",
    //   "key": " ",
    //   "keyColor": "yellow",
    // },
    // {
    //   "type": "packages",
    //   "format": "{} (pacman)",
    //   "key": " ",
    //   "keyColor": "yellow",
    // },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "yellow",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "yellow",
    },
    "break",
    // {
    //   "type": "wm",
    //   "key": " ",
    //   "keyColor": "yellow",
    // },
    // {
    //   "type": "cpu",
    //   "format": "{1} ({3}) @ {7} GHz",
    //   "key": " ",
    //   "keyColor": "yellow",
    // },
    // {
    //   "type": "gpu",
    //   "format": "{1} {2} @ {12} GHz",
    //   "key": " 󰢮 ",
    //   "keyColor": "yellow",
    // },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "yellow",
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "keyColor": "yellow",
    },
    // {
    //   "type": "monitor",
    //   "key": " ",
    //   "keyColor": "yellow",
    // },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "yellow",
    },

    "break",
    {
      "type": "publicip",
      "key": "⅊ ",
      "keyColor": "yellow",
      "format": "{ip} - {location}",
    },
    {
      "type": "localip",
      "key": "ł ",
      "keyColor": "yellow",
      "format": "{ipv4~0,-3} - {mac}",
      "showMac": true,
    },
    {
      "type": "wifi",
      "key": "ᯤ ",
      "keyColor": "yellow",
      "format": "{ssid} - {signal-quality} - {status}",
    },
    // {
    //   "type": "media",
    //   "key": "󰝚 ",
    //   "keyColor": "yellow",
    // },
    // {
    //   "type": "colors",
    // },
    "break",
    "break",
  ],
}
