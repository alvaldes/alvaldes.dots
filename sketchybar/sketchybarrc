#!/bin/bash

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                          GENTLEMAN SKETCHYBAR                                ║
# ║                     Minimal Islands - Floating Style                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# This file is a manifest, not the whole configuration. It owns exactly three things
# and nothing else:
#
#   1. the bar
#   2. the item defaults every item inherits  — this IS the island definition
#   3. the list of item definitions to load
#
# Colours live in colors.sh, glyphs in icons.sh, fonts and geometry in theme.sh, item
# definitions in items/*.sh and runtime logic in plugins/*.sh. Nothing here hardcodes
# a colour, a glyph, a font or a measurement.
#
# To park an item, comment out its `source` line below. items/meeting.sh is parked
# that way on purpose.

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
ITEM_DIR="$CONFIG_DIR/items"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"
source "$CONFIG_DIR/theme.sh"

# ─────────────────────────────────────────────────────────────────────────────────
# BAR
#
# A transparent base: every visible surface comes from an item background, so the bar
# body itself draws nothing. y_offset starts above the screen edge and is animated
# down on (re)load.
#
# NOTE: notch_width / notch_offset are accepted by this sketchybar build but never
# show up in `sketchybar --query bar`. They are kept as-is rather than deleted,
# because their being inert could not be proven.
# ─────────────────────────────────────────────────────────────────────────────────
BAR=(
  height=30
  blur_radius=0
  position=top
  sticky=on
  padding_left=8
  padding_right=8
  color=$BAR_COLOR
  corner_radius=0
  y_offset=-50
  margin=0
  notch_width=188
  notch_offset=0
)

# ─────────────────────────────────────────────────────────────────────────────────
# ITEM DEFAULTS — the island definition
#
# Every item created after this point is an island, which is why items/*.sh only
# declares what makes each item different. Items that must NOT be an island opt out
# with background.drawing=off (see items/spaces.sh and items/separator.sh).
#
# background.drawing is set explicitly on purpose: the official property docs state
# its default is `off`, while this build reports `on` from
# `sketchybar --query defaults`. Being explicit means the bar's appearance does not
# depend on which of the two is right.
#
# updates=when_shown stops a hidden item from running its routine script — anything
# inside a closed popup, or hidden by a space/display association. It does not change
# polling frequency: update_freq still controls how often a *visible* item runs.
# ─────────────────────────────────────────────────────────────────────────────────
DEFAULTS=(
  updates=when_shown
  icon.font="$FONT_ICON"
  icon.color=$WHITE
  icon.padding_left=$PAD_ICON_L
  icon.padding_right=$PAD_ICON_R
  label.font="$FONT_LABEL"
  label.color=$WHITE
  label.padding_left=$PAD_LABEL_L
  label.padding_right=$PAD_LABEL_R
  background.drawing=on
  background.color=$ISLAND_BG
  background.border_color=$ISLAND_BORDER
  background.blur_radius=$ISLAND_BLUR
  background.border_width=$ISLAND_BORDER_W
  background.corner_radius=$ISLAND_R
  background.height=$ISLAND_H
  padding_left=$PAD_ITEM
  padding_right=$PAD_ITEM
)

sketchybar --bar "${BAR[@]}"

# Slide down from above on load.
sketchybar --animate sin 12 --bar y_offset=-50 y_offset=2

sketchybar --default "${DEFAULTS[@]}"

# ═══════════════════════════════════════════════════════════════════════════════
#                                ITEMS
# ═══════════════════════════════════════════════════════════════════════════════
# Left to right:  workspaces, separator, front app.
# Right to left:  battery, datetime, volume, cpu, gpu, ram.

source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/separator.sh"
source "$ITEM_DIR/front_app.sh"

source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/datetime.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/gpu.sh"
source "$ITEM_DIR/ram.sh"

# Parked, not loaded — uncomment to enable:
# source "$ITEM_DIR/meeting.sh"

# ─────────────────────────────────────────────────────────────────────────────────
# FINALIZE
# Runs every item script once so the bar is fully painted on load. Must stay last, and
# must never be called from inside a plugin (it would recurse).
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --update
